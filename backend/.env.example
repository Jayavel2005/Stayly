# =============================================================================
# Stayora Backend API — Environment Configuration Template
# Copy this file to .env and configure local values
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL 16+)
DATABASE_URL=postgresql://stayora:stayora@localhost:5432/stayora_db?schema=public

# Security & Authentication (Future Phase)
JWT_SECRET=your_jwt_secret_key_min_32_characters
JWT_EXPIRES_IN=15m

# Cache & Message Broker (Future Phase)
REDIS_HOST=localhost
REDIS_PORT=6379

# Cross-Origin Resource Sharing (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
